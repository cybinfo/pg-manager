# =============================================================================
# ManageKar Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Required - Supabase
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings > API

# The URL of your Supabase project (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The anonymous/public key for client-side Supabase access
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key for server-side operations (cron jobs, admin APIs)
# WARNING: This key bypasses Row Level Security. Never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Optional - Cron Jobs
# -----------------------------------------------------------------------------

# Secret used to authenticate cron job requests (set in Vercel project settings)
CRON_SECRET=

# -----------------------------------------------------------------------------
# Optional - Email (Resend)
# -----------------------------------------------------------------------------
# Emails are disabled when RESEND_API_KEY is not set

# Resend API key for sending transactional emails
RESEND_API_KEY=

# Sender email address (defaults to "ManageKar <onboarding@resend.dev>" if not set)
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Optional - Application
# -----------------------------------------------------------------------------

# Public-facing app URL used in email links (defaults to https://managekar.com)
NEXT_PUBLIC_APP_URL=

# Set to "true" to enable demo mode (read-only, no real data modifications)
NEXT_PUBLIC_DEMO_MODE=
